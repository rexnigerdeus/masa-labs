# Projet Supabase partagé (mêmes valeurs que Vitae et Hive : une seule base,
# des tables préfixées par application). La clé anon est publique par
# construction : elle ne donne accès qu'à ce que les policies RLS autorisent.
# Copier les valeurs depuis apps/hive/.env.local plutôt que les retaper : une
# clé recopiée à la main avec un caractère de travers casse l'inscription sans
# message clair (401 « Invalid API key »).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse de l'application. Facultative sur Vercel, qui la déduit du projet.
NEXT_PUBLIC_APP_URL=
