# Adresse publique de l'application Vitae, vers laquelle tous les appels à
# l'action renvoient (avec ?ref=everydayco). OBLIGATOIRE : le build de
# production échoue sans elle.
NEXT_PUBLIC_VITAE_URL=

# Adresse du site lui-même, sur son domaine propre (https://theeverydayco.ci
# par exemple). Sert à la canonique, au plan du site, et déclenche la
# redirection permanente de the-everyday-co.vercel.app vers ce domaine.
NEXT_PUBLIC_SITE_URL=

# Boîte de contact sur le domaine (contact@<domaine>). Une adresse Gmail est
# ignorée. Sans elle, « Organiser un atelier », « Nous écrire » et « Contact »
# n'apparaissent pas.
NEXT_PUBLIC_CONTACT_EMAIL=

# Chaîne WhatsApp de Vitae. Sans elle, « Suivre sur WhatsApp » n'apparaît pas.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# Politique de confidentialité de Vitae, citée par /confidentialite.
NEXT_PUBLIC_VITAE_PRIVACY_URL=
