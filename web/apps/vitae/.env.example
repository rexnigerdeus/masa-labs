# Projet Supabase. La clé anon est publique par construction : elle ne donne
# accès qu'à ce que les policies RLS autorisent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse de l'application. Facultative sur Vercel, qui la déduit du projet.
NEXT_PUBLIC_APP_URL=

# Site vitrine The Everyday Co. Sans elle, le pied de page affiche le nom
# sans lien plutôt qu'un lien mort.
NEXT_PUBLIC_SITE_URL=

# Adresse de contact citée par /confidentialite (contact@<domaine> quand le
# domaine sera posé).
NEXT_PUBLIC_CONTACT_EMAIL=

# Lien de la chaîne WhatsApp « Vitae — Stages & premiers emplois ». Sans lui,
# les boutons vers la chaîne ne s'affichent pas.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# ---------------------------------------------------------------------------
# Lot B — paiements. Tout reste éteint tant que PAYMENTS_ENABLED n'est pas
# exactement « true » : les boutons payants mènent à la liste d'attente.
# Variables SERVEUR uniquement : jamais de préfixe NEXT_PUBLIC_ ici.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false

# Clé API Wave Business (Checkout), créée dans l'espace marchand Wave.
WAVE_API_KEY=
# Secret de signature des webhooks Wave (stratégie « signing secret »).
WAVE_WEBHOOK_SECRET=

# Clé service_role Supabase : utilisée par le seul webhook Wave pour accorder
# un droit. Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
