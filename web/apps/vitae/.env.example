# Projet Supabase. La clé anon est publique par construction : elle ne donne
# accès qu'à ce que les policies RLS autorisent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse de l'application. Facultative sur Vercel, qui la déduit du projet.
NEXT_PUBLIC_APP_URL=

# Site vitrine The Everyday Co. Sans elle, le pied de page affiche le nom
# sans lien plutôt qu'un lien mort.
NEXT_PUBLIC_SITE_URL=
