# Projet Supabase partagé (mêmes valeurs que Vitae : une seule base, des
# tables préfixées par application). La clé anon est publique par
# construction : elle ne donne accès qu'à ce que les policies RLS autorisent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse de l'application. Facultative sur Vercel, qui la déduit du projet.
NEXT_PUBLIC_APP_URL=

# Paiement en ligne (Mobile Money / carte via agrégateur). Reste à "false"
# tant que le compte marchand n'est pas ouvert : tant qu'il vaut false, le
# seul mode proposé est le paiement en main propre.
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=false

# Numéro WhatsApp du support, affiché en pied de page pendant le lancement
# (brief §6.5). Format international sans "+", ex : 2250700000000.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
